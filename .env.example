# Supabase (self-hosted on Railway)
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase.railway.app
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin scheduler — author email for AI-generated community posts. Must
# match an existing public.users.email row.
ADMIN_SCHEDULER_EMAIL=your-admin@example.com
# Storage URL is derived from NEXT_PUBLIC_SUPABASE_URL — no separate var.

# Stripe. Secret + publishable are the live or test keys. The webhook
# secret comes from `stripe listen` (local) or the dashboard endpoint.
# Price ids are the Stripe price ids for each plan.
STRIPE_SECRET_KEY=sk_test_your_key
STRIPE_WEBHOOK_SECRET=whsec_your_secret
STRIPE_PUBLISHABLE_KEY=pk_test_your_key
# Checkout sells the new monthly prices. Create them in Stripe, then set these.
# Do not point them at the old $99 or $849 prices.
STRIPE_PRICE_VIP_MONTHLY_149=price_...
STRIPE_PRICE_PRO_MONTHLY_599=price_...
# Legacy price ids. Webhook mapping only. Do not delete. Existing subscribers
# stay on these prices. Leave a var unset when that price id is already on a
# prices.stripe_price_id row.
STRIPE_PRICE_VIP_MONTHLY=price_...
STRIPE_PRICE_VIP_MONTHLY_99=price_...
STRIPE_PRICE_VIP_MONTHLY_49=price_...
STRIPE_PRICE_VIP_ANNUAL=price_...
STRIPE_PRICE_VIP_ANNUAL_490=price_...
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_MONTHLY_849=price_...
STRIPE_PRICE_PRO_MONTHLY_249=price_...
STRIPE_PRICE_PRO_ANNUAL=price_...
STRIPE_PRICE_PRO_ANNUAL_2490=price_...

# PLACEHOLDER LIVE event ticket discounts. Whole percents. Change these on
# Railway without a code edit. Logged-out buyers are always 0. Checkout
# reads the signed-in member's tier on the server and ignores any percent
# sent by the browser.
LIVE_DISCOUNT_PCT_COMMUNITY=0
LIVE_DISCOUNT_PCT_VIP=10
LIVE_DISCOUNT_PCT_PRO=20

# Conversations AI (AI George) inbound webhook. Shared secret on
# POST /api/webhooks/vendasta-conversations as header x-webhook-secret.
# Set in Railway. Do not reuse VENDASTA_WEBHOOK_SECRET from archived #80.
VENDASTA_CONVERSATIONS_WEBHOOK_SECRET=

# Resend
RESEND_API_KEY=re_your_key
# LIVE Evolved Pros thank-you mail: *@evolvedpros.com or *@mail.evolvedpros.com ONLY.
# Never reports.evolvex360.com / EVX. The thanks sender refuses any other host.
RESEND_FROM_EMAIL=noreply@evolvedpros.com
# Optional. Booking inquiry email alert (in-app admin bell is the required path).
# Falls back to ADMIN_SCHEDULER_EMAIL, then the address inside RESEND_FROM_EMAIL.
ADMIN_NOTIFY_EMAIL=george@evolvex360.com

# App origins — these are NOT duplicates. Railway should keep BOTH.
#
# LIVE host split (2026-09-29, George YES via CoS, sitemap hygiene sprint):
# www.evolvedpros.com and platform.evolvedpros.com both serve this Railway
# app. www is the public indexable origin. platform is the member app.
# Approved public paths 308 from platform to www. Do not point auth/app
# URLs at www: Supabase cookies are host-scoped to platform, and a magic
# link that lands on www sets the session on the wrong host.
#
# NEXT_PUBLIC_APP_URL (canonical, required on the web service)
#   Where this Next app is served. Auth callbacks, Stripe return URLs,
#   emails, guest/invite links. Production MUST be:
#   https://platform.evolvedpros.com
#   (media.evolvedpros.com is a host rewrite onto the same app; do not
#   point APP_URL at the media host.)
#
# NEXT_PUBLIC_SITE_URL (brand / SEO)
#   Brand origin for callers of this env. Falls back to APP_URL if unset.
#   Sitemap and HTML canonicals use the www CANONICAL_ORIGIN in code.
#   Never the *.up.railway.app host.
NEXT_PUBLIC_APP_URL=https://platform.evolvedpros.com
NEXT_PUBLIC_SITE_URL=https://platform.evolvedpros.com

# HMAC secret for unpublished media preview links.
# /media/preview/[slug]?token=... expires after 7 days.
# Admin sessions can open a preview without it. Minting a share link requires it.
# Use a long random string. Replacing it invalidates outstanding links.
PREVIEW_TOKEN_SECRET=

# Audience analytics (platform.evolvedpros.com) — optional. Leave blank to
# skip loading that layer. Do not commit real IDs. See docs/ANALYTICS.md.
# GA4 page views / sessions / geo / engaged sessions (G-XXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Google Search Console HTML-tag verification (content= value only)
NEXT_PUBLIC_GSC_VERIFICATION=
# Microsoft Clarity heatmaps + session replay (project ID)
NEXT_PUBLIC_CLARITY_ID=

# Mux. Leave blank. Do not commit real values.
# API access token (asset uploads and the lesson signer).
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
# Mux-Signature HMAC. The webhook refuses unsigned bodies when this is unset.
MUX_WEBHOOK_SECRET=
# Signing key id and base64 PKCS8 private key. Fit playback tokens (15 min).
MUX_SIGNING_KEY=
MUX_PRIVATE_KEY=
