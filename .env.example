# Supabase (self-hosted on Railway)
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase.railway.app
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin scheduler — author email for AI-generated community posts. Must
# match an existing public.users.email row.
ADMIN_SCHEDULER_EMAIL=your-admin@example.com
# Storage URL is derived from NEXT_PUBLIC_SUPABASE_URL — no separate var.

# Stripe. Secret + publishable are the live or test keys. The webhook
# secret comes from `stripe listen` (local) or the dashboard endpoint.
# Price ids are the Stripe price ids for each plan.
STRIPE_SECRET_KEY=sk_test_your_key
STRIPE_WEBHOOK_SECRET=whsec_your_secret
STRIPE_PUBLISHABLE_KEY=pk_test_your_key
STRIPE_PRICE_VIP_MONTHLY=price_...
STRIPE_PRICE_VIP_ANNUAL=price_...
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_ANNUAL=price_...

# Conversations AI (AI George) inbound webhook. Shared secret on
# POST /api/webhooks/vendasta-conversations as header x-webhook-secret.
# Set in Railway. Do not reuse VENDASTA_WEBHOOK_SECRET from archived #80.
VENDASTA_CONVERSATIONS_WEBHOOK_SECRET=

# Resend
RESEND_API_KEY=re_your_key
# LIVE Evolved Pros thank-you mail: *@evolvedpros.com or *@mail.evolvedpros.com ONLY.
# Never reports.evolvex360.com / EVX. The thanks sender refuses any other host.
RESEND_FROM_EMAIL=noreply@evolvedpros.com
# Optional. Booking inquiry email alert (in-app admin bell is the required path).
# Falls back to ADMIN_SCHEDULER_EMAIL, then the address inside RESEND_FROM_EMAIL.
ADMIN_NOTIFY_EMAIL=george@evolvex360.com

# App origins — these are NOT duplicates. Railway should keep BOTH.
#
# NEXT_PUBLIC_APP_URL (canonical, required on the web service)
#   Where this Next app is served. Auth callbacks, Stripe return URLs,
#   emails, guest/invite links. Production MUST be the www host:
#   https://www.evolvedpros.com
#   Do not set this to platform.evolvedpros.com — that host 308s to www
#   (GATE-1b) and a host-scoped auth cookie set on platform is dropped
#   on the hop, which breaks magic-link exchange.
#   (media.evolvedpros.com is a host rewrite onto the same app; do not
#   point APP_URL at the media host.)
#
# NEXT_PUBLIC_SITE_URL (brand / SEO)
#   Canonical + OG + sitemap + RSS origin. Falls back to APP_URL if unset.
#   Production: https://www.evolvedpros.com
#   Never the *.up.railway.app host or platform.evolvedpros.com.
NEXT_PUBLIC_APP_URL=https://www.evolvedpros.com
NEXT_PUBLIC_SITE_URL=https://www.evolvedpros.com

# Audience analytics (platform.evolvedpros.com) — optional. Leave blank to
# skip loading that layer. Do not commit real IDs. See docs/ANALYTICS.md.
# GA4 page views / sessions / geo / engaged sessions (G-XXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Google Search Console HTML-tag verification (content= value only)
NEXT_PUBLIC_GSC_VERIFICATION=
# Microsoft Clarity heatmaps + session replay (project ID)
NEXT_PUBLIC_CLARITY_ID=
