# Supabase (self-hosted on Railway)
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase.railway.app
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Vendasta automation webhook (Sprint VENDASTA-WEBHOOK-REFACTOR)
# Generate locally: openssl rand -hex 16
VENDASTA_VERIFIER_TOKEN=your-verifier-token
VENDASTA_API_BASE_URL=https://prod.apigateway.co
VENDASTA_PARTNER_ID=C5L0

# Resend
RESEND_API_KEY=re_your_key
RESEND_FROM_EMAIL=noreply@evolvedpros.com

# App
NEXT_PUBLIC_APP_URL=https://evolvedpros.up.railway.app
NEXT_PUBLIC_SITE_URL=https://platform.evolvedpros.com
