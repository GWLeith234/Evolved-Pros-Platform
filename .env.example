# Supabase (self-hosted on Railway)
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase.railway.app
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Vendasta automation webhook (Sprint VENDASTA-WEBHOOK-REFACTOR)
# Generate locally: openssl rand -hex 16
VENDASTA_VERIFIER_TOKEN=your-verifier-token
# Optional HMAC secret. When set, /api/webhooks/vendasta also verifies the
# `x-vendasta-signature` header (HMAC-SHA256 over the raw body, hex-encoded).
# Leave unset until Alistair's automation starts signing payloads.
VENDASTA_WEBHOOK_SECRET=
VENDASTA_API_BASE_URL=https://prod.apigateway.co
VENDASTA_PARTNER_ID=C5L0
# Vendasta CRM org id used by /api/ask-george and /api/vendasta/signal.
# Same value as VENDASTA_PARTNER_ID for the platform org today, kept as a
# distinct var because the apigateway routes use "org" semantics.
VENDASTA_ORG_ID=your-org-id
# Ask-George chat assistant id (Vendasta widget UUID).
VENDASTA_WIDGET_ID=your-widget-id

# Admin scheduler — author email for AI-generated community posts. Must
# match an existing public.users.email row.
ADMIN_SCHEDULER_EMAIL=your-admin@example.com
# Storage URL is derived from NEXT_PUBLIC_SUPABASE_URL — no separate var.

# Resend
RESEND_API_KEY=re_your_key
RESEND_FROM_EMAIL=noreply@evolvedpros.com

# App
NEXT_PUBLIC_APP_URL=https://evolvedpros.up.railway.app
NEXT_PUBLIC_SITE_URL=https://platform.evolvedpros.com
