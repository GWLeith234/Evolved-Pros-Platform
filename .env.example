# Supabase (self-hosted on Railway)
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase.railway.app
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Vendasta automation webhook (Sprint VENDASTA-WEBHOOK-REFACTOR)
# Generate locally: openssl rand -hex 16
VENDASTA_VERIFIER_TOKEN=your-verifier-token
# Marketplace product SKUs (MP-{hash} style) — one NEXT_PUBLIC_ var per plan,
# read by the pricing/membership pages, the /api/checkout allowlist, AND the
# webhook SKU→tier mapper. Values come from the Vendasta marketplace listing.
NEXT_PUBLIC_VENDASTA_MP_VIP_M=
NEXT_PUBLIC_VENDASTA_MP_VIP_Y=
NEXT_PUBLIC_VENDASTA_MP_PRO_M=
NEXT_PUBLIC_VENDASTA_MP_PRO_Y=
VENDASTA_MP_COMMUNITY=
VENDASTA_API_BASE_URL=https://prod.apigateway.co
VENDASTA_PARTNER_ID=C5L0
# Vendasta CRM org id used by /api/ask-george and /api/vendasta/signal.
# Same value as VENDASTA_PARTNER_ID for the platform org today, kept as a
# distinct var because the apigateway routes use "org" semantics.
VENDASTA_ORG_ID=your-org-id
# Ask-George chat assistant id (Vendasta widget UUID).
VENDASTA_WIDGET_ID=your-widget-id

# Admin scheduler — author email for AI-generated community posts. Must
# match an existing public.users.email row.
ADMIN_SCHEDULER_EMAIL=your-admin@example.com
# Storage URL is derived from NEXT_PUBLIC_SUPABASE_URL — no separate var.

# Stripe (SPRINT I Phase 1 — TEST MODE ONLY in this phase).
# Secret + publishable are the test-mode keys (sk_test_…, pk_test_…). The
# webhook secret comes from `stripe listen` (local) or the dashboard endpoint.
# Price ids are the TEST-mode price ids for each plan. Set
# NEXT_PUBLIC_PAYMENTS_PROVIDER=stripe to route the membership upgrade CTA
# through Stripe Checkout instead of the legacy Vendasta flow.
STRIPE_SECRET_KEY=sk_test_your_key
STRIPE_WEBHOOK_SECRET=whsec_your_secret
STRIPE_PUBLISHABLE_KEY=pk_test_your_key
STRIPE_PRICE_VIP_MONTHLY=price_...
STRIPE_PRICE_VIP_ANNUAL=price_...
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_ANNUAL=price_...
NEXT_PUBLIC_PAYMENTS_PROVIDER=vendasta

# Resend
RESEND_API_KEY=re_your_key
RESEND_FROM_EMAIL=noreply@evolvedpros.com

# App
# Auth host. Auth redirects / cookies depend on this matching the Railway host —
# do NOT change it casually (it has broken sign-in before).
NEXT_PUBLIC_APP_URL=https://evolvedpros.up.railway.app
# App/marketing host used for auth+CRM: Vendasta magic-link redirectTo, the
# password-reset origin fallback, and the internal /api/vendasta/signal
# self-fetch all read this. It must resolve to the running app — do NOT point it
# at the public marketing domain or auth/CRM will break.
NEXT_PUBLIC_SITE_URL=https://platform.evolvedpros.com
# Canonical public brand origin for SEO ONLY (canonical/OG/sitemap/RSS).
# Separate from the two above on purpose so the public domain can differ from
# the app host with zero auth risk. Never used for auth redirects. Falls back to
# https://evolvedpros.com in code when unset.
NEXT_PUBLIC_CANONICAL_URL=https://evolvedpros.com
